# divers . loisirs . culture . jeux de hasard et d'argent:
#   titre: Jeux de hasard et d'argent
#   applicable si: présent
#   icônes: 🎲
#   formule: moyenne macro pondérée
#   unité: kgCO2e
#   note: |
#     Nous répartissons l'empreinte du secteur sur l'ensemble des joueurs parmi la population.

# divers . loisirs . culture . jeux de hasard et d'argent . présent:
#   question: Vous  arrive t-il de jouer à des jeux de hasard et d'argent ?
#   par défaut: non

# divers . loisirs . culture . jeux de hasard et d'argent . moyenne macro pondérée:
#   formule: moyenne macro française / proportion de pratiquants

# divers . loisirs . culture . jeux de hasard et d'argent . moyenne macro française:
#   formule: empreinte branche . R92 par hab
#   unité: kgCO2e
#   note: |
#     Ici, nous prenons en compte toute la branche correspondant aux jeux de hasard et d'argent.

# divers . loisirs . culture . jeux de hasard et d'argent . proportion de pratiquants:
#   formule: 0.472
#   note: |
#     D'après [cette étude de 2020](https://www.vie-publique.fr/en-bref/274997-jeux-dargent-et-de-hasard-les-francais-jouent-moins-mais-misent-plus), à peu près la moitié des Français jouent à des jeux de hasard et d'argent.

divers . loisirs . sports:
  icônes: 🏟️
  formule:
    variations:
      - si: divers . loisirs . sports . pratique
        alors: pratiques sportives communes
      - sinon: pratiques sportives individuelles


divers . loisirs . sports . pratique:
  question: Les membres de votre foyer ont-ils les mêmes pratiques sportives ?
  par défaut: oui

divers . loisirs . sports . pratiques sportives communes:
  applicable si: divers . loisirs . sports . pratique
  mosaique:
    type: selection
    options:
      - individuel extérieur . présent
      - balle ou ballon . présent
      - aquatique . présent
      - salle de sport . présent
      - martial ou combat . présent
      - athlétisme . présent
      - équitation . présent
      - golf . présent
      - nautique . présent
      - hiver montagne . présent
      - sports énergivores . présent
      - autres sports . présent
    suggestions:
      aucun sport:
        individuel extérieur . présent: non
        balle ou ballon . présent: non
        aquatique . présent: non
        salle de sport . présent: non
        martial ou combat . présent: non
        athlétisme . présent: non
        équitation . présent: non
        golf . présent: non
        nautique . présent: non
        hiver montagne . présent: non
        sports énergivores . présent: non
        autres sports . présent: non
  question: Quelles sont les pratiques sportives communes dans votre foyer ?
  titre: Pratiques sportives communes
  formule:
    variations:
      - si: choix utilisateur
        alors: empreinte sportif
      - sinon: empreinte par défaut

divers . loisirs . sports . pratiques sportives individuelles:
  applicable si: divers . loisirs . sports . pratique = non
  titre: Pratiques sportives individuelles
  formule:
    somme:
      - membre 1
      - membre 2

divers . loisirs . sports . pratiques sportives individuelles . membre 1:
  mosaique:
    type: selection
    options:
      - divers . loisirs . sports . individuel extérieur . présent
      - divers . loisirs . sports . balle ou ballon . présent
      - divers . loisirs . sports . aquatique . présent
